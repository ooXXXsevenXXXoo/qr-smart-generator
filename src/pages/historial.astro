---
import Layout from '../layouts/Layout.astro';

---

<Layout title="Historial QR">

  <h1
    style="
      text-align:center;
      margin-bottom:2rem;
    "
  >
    Historial de QR
  </h1>

  <div
    id="contenedorHistorial"
    style="
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:2rem;
    "
  ></div>

  <script is:inline>

    const contenedor =
      document.getElementById('contenedorHistorial');

    let historial =
      JSON.parse(
        localStorage.getItem('historialQR') || '[]'
      );

    if (historial.length === 0) {

      contenedor.innerHTML = `
        <p
          style="
            text-align:center;
            grid-column:1/-1;
            color:#6b7280;
            font-size:1.1rem;
          "
        >
          No hay códigos QR guardados.
        </p>
      `;

    } else {

      historial.forEach((item, index) => {

        const qrUrl =
          `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(item.texto)}`;

        const tarjeta = document.createElement('div');

        tarjeta.style.background = 'white';
        tarjeta.style.borderRadius = '20px';
        tarjeta.style.padding = '1.5rem';
        tarjeta.style.boxShadow =
          '0 10px 25px rgba(0,0,0,0.08)';
        tarjeta.style.textAlign = 'center';

        tarjeta.innerHTML = `

          <img
            src="${qrUrl}"
            alt="QR"
            style="
              width:220px;
              height:220px;
              margin:auto;
              display:block;
            "
          />

          <p
            style="
              margin-top:1rem;
              word-break:break-all;
              color:#374151;
            "
          >
            ${item.texto}
          </p>

          <p
            style="
              color:#6b7280;
              font-size:0.9rem;
              margin-top:0.5rem;
            "
          >
            ${item.fecha}
          </p>

          <button
            data-index="${index}"
            style="
              margin-top:1rem;
              background:#dc2626;
              color:white;
              border:none;
              padding:10px 16px;
              border-radius:10px;
              cursor:pointer;
              font-weight:bold;
            "
          >
            Eliminar
          </button>

        `;

        const boton =
          tarjeta.querySelector('button');

        boton.addEventListener('click', () => {

          historial.splice(index, 1);

          localStorage.setItem(
            'historialQR',
            JSON.stringify(historial)
          );

          location.reload();

        });

        contenedor.appendChild(tarjeta);

      });

    }

  </script>

</Layout>